@{
    ViewData["Title"] = "Không đủ quyền — Sakura";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Barlow:wght@600;700;800&display=swap');

    :root {
        --red:        #C8102E;
        --red-dark:   #9B0B22;
        --red-mid:    #E63950;
        --red-light:  #FFE5E9;
        --red-xlight: #FFF5F6;
        --white:      #FFFFFF;
        --gray-50:    #F9FAFB;
        --gray-200:   #E5E7EB;
        --gray-500:   #6B7280;
        --gray-900:   #111827;
        --shadow-md:  0 4px 20px rgba(200,16,46,0.12);
        --font-body:  'Inter', sans-serif;
        --font-head:  'Barlow', sans-serif;
    }

    body {
        background: var(--gray-50) !important;
        background-image:
            radial-gradient(ellipse at 10% 30%, rgba(200,16,46,0.05) 0%, transparent 55%),
            radial-gradient(ellipse at 90% 70%, rgba(230,57,80,0.04) 0%, transparent 50%) !important;
        color: var(--gray-900) !important; font-family: var(--font-body) !important;
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
    }
    body::before { content: none !important; }

    .dn-card {
        text-align: center; background: var(--white); border: 1px solid rgba(200,16,46,0.07);
        border-radius: 18px; padding: 40px 36px; box-shadow: var(--shadow-md); max-width: 380px;
    }
    .dn-icon { font-size: 40px; margin-bottom: 14px; }
    .dn-card h1 { font-family: var(--font-head); font-size: 22px; font-weight: 800; color: var(--red-dark); }
    .dn-card p { font-size: 0.85rem; color: var(--gray-500); margin-top: 10px; line-height: 1.6; }
    .dn-back {
        display: inline-block; margin-top: 20px; font-family: var(--font-body); font-size: 0.8rem;
        font-weight: 600; color: var(--red-dark); text-decoration: none; border-bottom: 1px solid var(--red-light);
    }

    /* ── Language switcher — fixed top-right, shared across all Sakura pages ── */
    .sk-lang-switch {
        position: fixed; top: 18px; right: 22px; z-index: 100;
        display: flex; gap: 8px;
        background: var(--white); border: 1px solid var(--gray-200); border-radius: 20px;
        padding: 5px 6px; box-shadow: 0 1px 3px rgba(200,16,46,0.08);
    }
    .sk-lang-flag {
        width: 26px; height: 26px; border-radius: 50%; overflow: hidden;
        border: 1.5px solid transparent; padding: 0; cursor: pointer; background: none;
        display: flex; align-items: center; justify-content: center;
        opacity: 0.5; transition: opacity 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }
    .sk-lang-flag img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .sk-lang-flag:hover { opacity: 0.85; transform: translateY(-1px); }
    .sk-lang-flag.active { opacity: 1; border-color: var(--red); box-shadow: 0 0 0 2px rgba(200,16,46,0.12); }

    @@media (max-width: 560px) {
        .sk-lang-switch { top: 12px; right: 12px; padding: 4px 5px; gap: 6px; }
        .sk-lang-flag { width: 22px; height: 22px; }
    }
</style>

@await Html.PartialAsync("~/Views/Sakura/_LangSwitcher.cshtml")

<div class="dn-card">
    <div class="dn-icon">🔒</div>
    <h1 data-i18n="account.deniedTitle">Access Denied</h1>
    <p data-i18n="account.deniedMessage">Your account does not have permission to use this feature. Please contact a Line Leader/Admin if you need help.</p>
    <a class="dn-back" href="@Url.Content("~/sakura")" data-i18n="account.deniedBackHome">← Back to Sakura Home</a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/i18next@23.10.1/i18next.min.js"></script>
    <script src="~/js/sakura-i18n.js" asp-append-version="true"></script>
}
